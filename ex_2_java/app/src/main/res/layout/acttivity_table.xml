<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:stretchColumns="1">
    <TableRow android:background="@android:color/darker_gray">
        <TextView android:text="Hello TableLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:textColor="@color/white"/>
    </TableRow>

    <TableRow >
        <TextView android:text="Open..."
            android:padding="10dp"/>
        <TextView android:text="Ctrl-O"
            android:gravity="right"
            android:padding="10dp"/>
    </TableRow>

    <TableRow >
        <TextView android:text="Save..."
            android:padding="10dp"/>
        <TextView android:text="Ctrl-S"
            android:padding="10dp"
            android:gravity="right"/>
    </TableRow>

    <TableRow >
        <TextView android:text="Save as..."
            android:padding="10dp"/>
        <TextView android:text="Ctrl-Shift-S"
            android:gravity="right"
            android:padding="10dp"/>
    </TableRow>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>
    <TableRow >
        <TextView android:text="X Import..."
            android:padding="10dp"/>
    </TableRow>
    <TableRow >
        <TextView android:text="X Export..."
            android:padding="10dp"/>
        <TextView android:text="Ctrl-E"
            android:gravity="right"
            android:padding="10dp"/>
    </TableRow>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>
    <TableRow>
        <TextView
            android:text="Quit"
            android:padding="10dp"/>
    </TableRow>


</TableLayout>